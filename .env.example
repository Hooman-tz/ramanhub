ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+psycopg://raman:changeme@localhost:5432/ramanhub
POSTGRES_USER=raman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ramanhub

# Object storage (MinIO locally; same vars point at R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=raw-spectra
S3_BUCKET_PROCESSED=processed-spectra
S3_REGION=auto

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# LLM
ANTHROPIC_API_KEY=

# App
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=50

# Deferred (placeholders only, unused this pass)
SENTRY_DSN=
