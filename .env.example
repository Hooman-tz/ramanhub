ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+psycopg://raman:changeme@localhost:5432/ramanhub
POSTGRES_USER=raman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ramanhub

# Storage backend: "s3" (MinIO/R2, needs the vars below) or "local"
# (plain files under STORAGE_LOCAL_DIR — dev without Docker, never prod)
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=storage-data

# Object storage (MinIO locally; same vars point at R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=raw-spectra
S3_BUCKET_PROCESSED=processed-spectra
S3_REGION=auto

# Auth — three OAuth sign-in providers (leave a provider's id/secret blank to
# disable just that provider; see docs/OPERATIONS.md section 5).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/auth/orcid/callback
ORCID_LOGIN_REDIRECT_URI=http://localhost:8000/auth/orcid/callback
ORCID_ENV=sandbox
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# LLM (ingestion header parsing)
# Set ONE of the two keys below. LLM_PROVIDER=auto prefers OpenRouter when
# its key is present, so setting OPENROUTER_API_KEY alone is enough.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# `OPENROUTER` is also accepted as an alias for this name.
OPENROUTER_API_KEY=
# Open-weights and cheap by default. Must support tool/function calling.
# Run `make check-llm ARGS='--list'` to see what OpenRouter serves today —
# slugs get renamed and retired, so don't trust this line blindly.
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b

# App
# FRONTEND_URL is where OAuth callbacks redirect after sign-in — the Next.js
# web app's origin (`pnpm dev:web` serves it on :3000).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=50

# Deferred (placeholders only, unused this pass)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend monorepo (apps/web, apps/mobile) — loaded via `dotenv -e ../../.env`
# ---------------------------------------------------------------------------
# FastAPI base URL the Next.js `/api/*` rewrite forwards to. The browser only
# ever calls `/api/*` on the web origin, so the session cookie keeps working.
API_URL=http://127.0.0.1:8000
