ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+psycopg://raman:changeme@localhost:5432/ramanhub
POSTGRES_USER=raman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ramanhub

# Storage backend: "s3" (MinIO/R2, needs the vars below) or "local"
# (plain files under STORAGE_LOCAL_DIR — dev without Docker, never prod)
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=storage-data

# Object storage (MinIO locally; same vars point at R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=raw-spectra
S3_BUCKET_PROCESSED=processed-spectra
S3_REGION=auto

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# LLM (ingestion header parsing)
# Set ONE of the two keys below. LLM_PROVIDER=auto prefers OpenRouter when
# its key is present, so setting OPENROUTER_API_KEY alone is enough.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# `OPENROUTER` is also accepted as an alias for this name.
OPENROUTER_API_KEY=
# Open-weights and cheap by default. Must support tool/function calling.
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_FALLBACK_MODELS=qwen/qwen-2.5-7b-instruct

# App
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=50

# Deferred (placeholders only, unused this pass)
SENTRY_DSN=
