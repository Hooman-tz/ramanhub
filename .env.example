ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+psycopg://raman:changeme@localhost:5432/ramanhub
POSTGRES_USER=raman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ramanhub

# Storage backend: "s3" (MinIO/R2, needs the vars below) or "local"
# (plain files under STORAGE_LOCAL_DIR — dev without Docker, never prod)
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=storage-data

# Object storage (MinIO locally; same vars point at R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=raw-spectra
S3_BUCKET_PROCESSED=processed-spectra
S3_BUCKET_FIGURES=figures
S3_REGION=auto

# Auth — three OAuth sign-in providers (leave a provider's id/secret blank to
# disable just that provider; see docs/OPERATIONS.md section 5).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Two DISTINCT ORCID flows, and they must not share a path:
#   ORCID_REDIRECT_URI       = proof-of-control *link* (signed-in user attaches ORCID)
#   ORCID_LOGIN_REDIRECT_URI = *sign-in*
# Pointing both at the sign-in callback sends linking users through login.
ORCID_REDIRECT_URI=http://localhost:8000/users/me/orcid/callback
ORCID_LOGIN_REDIRECT_URI=http://localhost:8000/auth/orcid/callback
# "production" (orcid.org) or "sandbox" (sandbox.orcid.org). Sandbox
# credentials are issued immediately; production needs ORCID approval.
ORCID_ENV=sandbox
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# LLM (ingestion header parsing + abstract enrichment)
# Every LLM call routes through OpenRouter. Leave OPENROUTER_API_KEY empty to
# skip LLM features entirely — that is a no-op, not an error.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# `openrouter/free` is OpenRouter's free-model router: it picks a currently
# available zero-cost model that supports the parameters we send. Free-tier
# ceilings apply and are the usual cause of a 429 — 20 requests/minute, and
# 50/day until the account has bought $10 of lifetime credits (1000/day
# after). Users who add their own key in Settings spend their own quota.
OPENROUTER_MODEL=openrouter/free
# Priority-ordered fallback list. OpenRouter moves down it when a model is
# down, rate-limited, or rejects the request, and does not bill the failed
# attempt. Every entry must support `response_format`. These slugs churn —
# check https://openrouter.ai/models?max_price=0 if calls start failing.
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free
# Only route to providers that honour every parameter sent (chiefly
# `response_format`). Leave true unless debugging a routing problem.
OPENROUTER_REQUIRE_PARAMETERS=true
# Optional per-call-site overrides; empty => fall back to OPENROUTER_MODEL.
# Platform key only — a user who brought their own key chose their own model.
# OPENROUTER_INGESTION_MODEL=
# OPENROUTER_ENRICHMENT_MODEL=

# Bring-your-own-key: Fernet key encrypting user-supplied provider keys at
# rest. Empty disables the feature (the endpoints 503 and the settings card
# hides); there is deliberately no plaintext fallback. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=

# App
# FRONTEND_URL is where OAuth callbacks redirect after sign-in — the Next.js
# web app's origin (`pnpm dev:web` serves it on :3000).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Domain to scope auth cookies to. Leave EMPTY locally: both halves are
# `localhost`, so host-only cookies work (cookies ignore the port).
# In production the app and API are sibling subdomains
# (raman.spectra-in.site / api.spectra-in.site), so this must be the shared
# registrable parent — `.spectra-in.site` — or the session cookie the API
# sets is never sent to the web origin and sign-in won't stick.
COOKIE_DOMAIN=
MAX_UPLOAD_SIZE_MB=50

# Deferred (placeholders only, unused this pass)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend monorepo (apps/web, apps/mobile) — loaded via `dotenv -e ../../.env`
# ---------------------------------------------------------------------------
# FastAPI base URL the Next.js `/api/*` rewrite forwards to. The browser only
# ever calls `/api/*` on the web origin, so the session cookie keeps working.
API_URL=http://127.0.0.1:8000
