# ---------------------------------------------------------------------------
# Production .env for the single-VM deploy (docker-compose.prod.yml).
# Copy the repo-root .env.example to .env first, then overlay these values.
# Everything marked <SET ME> is a secret you generate — never commit the
# filled-in .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# --- VM / proxy -----------------------------------------------------------
# Domain Caddy gets a TLS cert for; must have an A record -> this VM's IP.
API_DOMAIN=api.spectra-in.site
# Address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=you@example.com

# --- Backend image (built by .github/workflows/backend-image.yml) --------
# Pin to a :sha-xxxxxxx tag once you want reproducible deploys; :latest tracks
# main. Leave unset to use the compose-file default (…/ramanhub-backend:latest).
BACKEND_IMAGE=ghcr.io/hooman-tz/ramanhub-backend:latest

# --- Database: Neon (free managed Postgres) ----------------------------
# Neon console -> your project -> Connection string. Use the POOLED string
# (host contains "-pooler"). app/config.py rewrites postgresql:// ->
# postgresql+psycopg:// automatically, so paste Neon's value verbatim.
DATABASE_URL=postgresql://<user>:<pass>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# --- App URLs (ADR-014 domain layout) ----------------------------------
FRONTEND_URL=https://raman.spectra-in.site
BACKEND_URL=https://api.spectra-in.site
# Sibling subdomains need the shared registrable parent or the auth cookie
# the API sets is never sent to the web app and sign-in won't stick.
COOKIE_DOMAIN=.spectra-in.site

# --- Object storage: Cloudflare R2 (free tier) ------------------------
# R2 dashboard -> Manage R2 API Tokens -> create token (Object Read & Write).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<SET ME>
S3_SECRET_ACCESS_KEY=<SET ME>
S3_REGION=auto
S3_BUCKET_RAW=raw-spectra
S3_BUCKET_PROCESSED=processed-spectra
S3_BUCKET_FIGURES=figures

# --- Auth ---------------------------------------------------------------
JWT_SECRET=<SET ME - long random string>
JWT_EXPIRES_HOURS=24

# OAuth: fill the providers you use; leave a provider's id/secret blank to
# disable just that one. Redirect URIs must match what you register with each
# provider AND stay on the api. host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.spectra-in.site/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.spectra-in.site/auth/github/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://api.spectra-in.site/users/me/orcid/callback
ORCID_LOGIN_REDIRECT_URI=https://api.spectra-in.site/auth/orcid/callback
# "production" (orcid.org) or "sandbox" while prod ORCID creds are pending.
ORCID_ENV=sandbox

# --- LLM (optional; empty key = feature is a no-op, not an error) -------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Misc -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
SENTRY_DSN=
